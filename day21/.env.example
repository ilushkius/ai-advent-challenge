# Скопируйте этот файл в .env и вставьте ваш ключ DeepSeek.
# .env никогда не коммитится в git (игнорируется корневым .gitignore).
DEEPSEEK_API_KEY=вставьте-сюда-ваш-ключ

# Ключ DeepSeek нужен агенту (ответы чата и план оркестрации моделью) и инструменту
# `summarize` сервера `data_server`: тот читает ключ из ЭТОГО файла
# (mcp_servers/data_server/config.py -> day21/.env) или из переменной окружения,
# потому что работает отдельным процессом. Без ключа `summarize` не падает: он
# переходит на агрегацию (движок `engine: "aggregation"`), а план строит эвристика
# дня, поэтому демо-сценарий и тесты работают офлайн (`--llm off` у data_server).

# Адрес бэкенда дня для фронтенда (день 21). Нужен, только если бэкенд поднят не на
# стандартном порту: фронтенд читает его из этой переменной (frontend/api_client.py).
# По умолчанию — http://127.0.0.1:8000.
# DAY21_BACKEND_URL=http://127.0.0.1:8000

# Модель эмбеддингов индексации документов (раздел «📦 Индексация», день 21).
# Читает бэкенд (backend/core/config.py -> EMBEDDING_MODEL). По умолчанию —
# мультиязычная MiniLM, понимающая русский; веса скачиваются в index/models/.
# DAY21_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Кросс-энкодер реранкера RAG (день 23, режимы `rerank`/`rerank_filter`).
# Читает домен (backend/domain/rag_filter.py -> RAG_RERANK_MODEL). По умолчанию —
# мультиязычная mmarco-mMiniLMv2, понимающая русский; веса кэшируются в index/models/.
# RAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Порог релевантности RAG (день 24): максимум косинуса лучшего фрагмента ниже порога
# -> режим dont_know (ответ не строится, модель не вызывается).
# Читает домен (backend/domain/rag_quotes.py -> RAG_RELEVANCE_THRESHOLD). Значение
# берётся на импорте модуля, поэтому после правки .env нужен рестарт бэкенда.
RAG_RELEVANCE_THRESHOLD=0.6

# Провайдер LLM (день 26): deepseek | local. Действует на POST /rag/query и на
# мини-чат; поле provider в теле запроса перекрывает это значение на один запрос.
# Читает бэкенд (backend/core/config.py -> LLM_PROVIDER) при старте.
LLM_PROVIDER=deepseek

# Локальная модель Ollama и адрес её HTTP API (день 26). Модель из корзины
# «8-12 GB VRAM» под RTX 5070 (12 GB); меньше — быстрее, но слабее.
LOCAL_LLM_MODEL=qwen2.5-coder:14b
LOCAL_LLM_URL=http://localhost:11434
