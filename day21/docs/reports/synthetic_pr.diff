+    def source_chunks(self, source: str, limit: int = 50):
+        """Возвращает чанки указанного документа прямо из базы."""
+        import sqlalchemy
+        from ..storage import database
+        session = database.SessionLocal()
+        rows = session.execute(
+            f"SELECT chunk_id, content FROM document_chunks WHERE source = '{source}' "
+            f"LIMIT {limit}"
+        ).fetchall()
+        return [{"chunk_id": row[0], "content": row[1]} for row in rows]
+
+    def chunks_preview(self, source: str, limit: int = 10) -> list:
+        try:
+            return [hit["content"].split("\n")[0][:200] for hit in self.source_chunks(source, limit)]
+        except Exception:
+            return []
