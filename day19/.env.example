# Скопируйте этот файл в .env и вставьте ваш ключ DeepSeek.
# .env никогда не коммитится в git (игнорируется корневым .gitignore).
DEEPSEEK_API_KEY=вставьте-сюда-ваш-ключ

# Ключ DeepSeek нужен и внутри процесса MCP-сервера: инструмент `summarize`
# собирает сводку вызовом DeepSeek (той же модели `deepseek-chat`, что и агент).
# Сервер читает ключ из ЭТОГО файла (mcp_server/config.py -> day19/.env) или из
# переменной окружения. Без ключа `summarize` не падает: он переходит на
# агрегацию (движок `engine: "aggregation"`), поэтому демо и тесты работают
# офлайн (`--llm off`).

# Адрес бэкенда дня для фронтенда и MCP-сервера (день 19). Нужен, только если
# бэкенд поднят не на стандартном порту: фронтенд читает его из этой переменной
# (frontend/api_client.py), и тем же адресом ставятся фоновые задачи, когда
# MCP-сервер запускают с `--backend-url`. По умолчанию — http://127.0.0.1:8000.
# DAY19_BACKEND_URL=http://127.0.0.1:8000
