*.py,cover

# Jupyter Notebooks
.ipynb_checkpoints

# === БОЛЬШИЕ ДАННЫЕ (RAG-ХРАНИЛИЩА) ===
# Векторные базы данных
*.faiss
*.hnsw
*.ann
*.milvus
*.qdrant
*.weaviate
*.pinecone

