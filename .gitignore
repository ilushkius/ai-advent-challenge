*.docx
*.txt
*.csv
*.jsonl

# Исключение: requirements.txt в папках дней должны попадать в git
# (конвенция проекта: у каждого дня свой requirements.txt).
!requirements.txt

# ML-модели
models/
*.model
*.bin
*.safetensors
*.gguf
*.onnx

# === ЛОГИ ===
logs/
*.log
*.pid
*.lock
*.tmp
*.temp

# === Окружение IDE и ОС ===
# VS Code — основной редактор разработки
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# IntelliJ IDEA
.idea/
*.iml
.classpath
.project
.settings/

# Системные файлы
.DS_Store
Thumbs.db

# === 1. Игнорируем абсолютно все файлы, начинающиеся на .env во всех папках ===
.env*

# === 2. Делаем исключение (!) конкретно для шаблонов .env.example ===
!.env.example

# === 3. SQLite-базы приложений (day7/agents.db создаётся при старте) ===
*.db
