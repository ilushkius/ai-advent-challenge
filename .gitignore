# === OMP AGENT (omp.sh) ===
# Служебные папки агента: кэш, логи, рабочие данные сессии.
# Логи и кэш сессий не должны улетать в Git.
.omp/cache/
.omp/logs/
.omp/agent/

# Локальная память / история агента — файловые БД
*.db
*.sqlite

# Логи и кэш других популярных ИИ-инструментов (на случай разовых запусков)
.continue/
.roo/
.cursor/
.windsurf/
.aider/
.codeium/
*.aider.chat.history.md
*.aider.input.history
*.claude-session.json

# === СЕКРЕТЫ И НАСТРОЙКИ (КРИТИЧЕСКИ ВАЖНО) ===
# Файлы с API-ключами Anthropic, OpenAI, DeepSeek и др.
.env
.env.*
!.env.example
secrets.toml
config.private.toml

# Ключи и сертификаты
*.key
*.pem
*.crt
*.secret
*.private
credentials/
secrets/

# === PYTHON ===
# Байт-код и кэш компиляции
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения
.venv/
venv/
ENV/
env/

# Дистрибутивы, сборка и пакеты
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
