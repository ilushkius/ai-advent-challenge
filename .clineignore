# Исключения для инструментов, читающих этот файл (Cline и совместимые).
# omp.sh читает `.gitignore` и `.clineignore` не поддерживает — правила ниже
# дублируют важное из корневого `.gitignore`, чтобы архив не попадал в контекст
# независимо от инструмента.
#
# Архив челленджа: снимки прошлых дней не читаем и не меняем (основная папка —
# day21/). Компактный эквивалент списка: day[1-9]/, day1[0-9]/, day20/
day1/
day2/
day3/
day4/
day5/
day6/
day7/
day8/
day9/
day10/
day11/
day12/
day13/
day14/
day15/
day16/
day17/
day18/
day19/
day20/
archive/

# Окружения, кэши и производные данные (любая глубина)
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.agents/
node_modules/
htmlcov/
.pytest_cache/

# Результаты прогонов и отчёты инструментов
output/
logs/
*.log
*.db
*.sqlite
.coverage
.coverage.*

# Индексы и веса моделей (день 21 генерирует их кодом)
index/
*.faiss
*.index
*.npy
*.npz
*.pkl
*.onnx
*.bin
*.safetensors
*.model
*.gguf

# Секреты
.env
.env.*
secrets.toml
*.key
*.pem
*.crt
