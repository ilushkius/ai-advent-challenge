# Это файл-пример (шаблон). Настоящий ключ хранится в файле .env.
#
# Чтобы настроить проект у себя:
#   1) скопируйте шаблон:   copy .env.example .env
#   2) вставьте свой настоящий ключ в .env вместо заглушки ниже
#
# Заглушку "sk-вставьте-сюда-ваш-ключ" скрипт распознаёт как
# неподходящий ключ и запросит настоящий в консоли.
#
# ВАЖНО: не выкладывайте .env с настоящим ключом в Git —
# добавьте ".env" в .gitignore.
#
# Получить ключ: https://platform.deepseek.com -> раздел "API Keys"

DEEPSEEK_API_KEY=sk-вставьте-сюда-ваш-ключ
